        <mxCell id="c1_pc4_28e6810c1b" value="Compute similarity loss in hidden space" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24.0" y="1826.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c1_pc5_866cf4fd9f" value="Total error = rebuild error + similarity error" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24.0" y="1932.0" width="200" height="70" as="geometry" /></mxCell>
