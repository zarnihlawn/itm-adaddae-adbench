        <mxCell id="c1_dset_4323071012" value="Learning mode?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="150.0" y="412.0" width="160" height="88" as="geometry" /></mxCell>
        <mxCell id="c1_pu_fb401bbde3" value="Without labels: use all samples for train and test" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24.0" y="536.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c1_ps_cf92cd400c" value="Partly labeled setup: train on normals only; test includes anomalies" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="236.0" y="536.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c1_p1_f3f3f41e8a" value="Set up the learning model" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130.0" y="642.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c1_p2_5df3b70c30" value="Build a fixed noise plan" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130.0" y="748.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c1_p3_bdf64148d0" value="For each training round and each data group" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130.0" y="854.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c1_p4_b2ad872a64" value="Pick a random noise level" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130.0" y="1066.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c1_p5_76226e4ae9" value="Add scheduled noise → noisy sample" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130.0" y="1172.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c1_p6_5f3a2d5ecc" value="Try to rebuild the clean sample and measure the error" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130.0" y="1278.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c1_d_c_1a34546376" value="Similarity learning enabled?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="150.0" y="1384.0" width="160" height="88" as="geometry" /></mxCell>
        <mxCell id="c1_pc1_f38f294edd" value="Build positive pairs:&#10;two clean samples" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24.0" y="1508.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c1_pc2_46673cd8da" value="Build negative pairs:&#10;clean vs noisy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24.0" y="1614.0" width="200" height="70" as="geometry" /></mxCell>
