<mxfile host="app.diagrams.net" pages="1"><diagram id="279d38cdc8" name="AdaDDAE full flowchart"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="460" pageHeight="2886" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n3dab5a2900" value="Start" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#D5E8D4;strokeColor=#82B366;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="110" height="44" as="geometry" /></mxCell><mxCell id="n9ab3b26b5e" value="Input: dataset features and labels" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="284" height="44" as="geometry" /></mxCell><mxCell id="n50a4f3c41f" value="Input: model settings and random seeds" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="313" height="44" as="geometry" /></mxCell><mxCell id="nc446c3b7ca" value="Detect learning mode&#10;(without labels / partly labeled)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="300" height="96" as="geometry" /></mxCell><mxCell id="ne481fb7368" value="Without labels:&#10;use all samples for train and test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="284" height="60" as="geometry" /></mxCell><mxCell id="ne947b7aacc" value="Partly labeled:&#10;train on normal samples only;&#10;test includes unusual samples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="418" width="247" height="77" as="geometry" /></mxCell><mxCell id="naf3bc52386" value="Prepare features&#10;(scale safely; reduce dimensions if needed)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="513" width="360" height="60" as="geometry" /></mxCell><mxCell id="nf7bf33ff2d" value="Optional: match encoding to data type&#10;(table / image / text)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="591" width="306" height="60" as="geometry" /></mxCell><mxCell id="n7540cfb50b" value="Estimate dataset size, shape, and noise level&#10;(no labels needed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="669" width="360" height="60" as="geometry" /></mxCell><mxCell id="n49058d15f2" value="Choose a noise plan that fits this dataset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="747" width="343" height="44" as="geometry" /></mxCell><mxCell id="ne1ab320f6a" value="Set up the learning model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="809" width="217" height="44" as="geometry" /></mxCell><mxCell id="n89ff1bc1f2" value="For each training round" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="871" width="202" height="44" as="geometry" /></mxCell><mxCell id="n78ec13e818" value="Pick a noise level and add noise to the sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="933" width="360" height="60" as="geometry" /></mxCell><mxCell id="n87ef261d59" value="Try to rebuild the clean sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1011" width="261" height="44" as="geometry" /></mxCell><mxCell id="n4056698a93" value="Measure rebuild error&#10;(+ similarity learning when useful)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1073" width="291" height="60" as="geometry" /></mxCell><mxCell id="ndeffc65f1b" value="Down-weight likely noisy training points" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1151" width="328" height="44" as="geometry" /></mxCell><mxCell id="na5c1c5db9b" value="Improve the model a little" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1213" width="224" height="44" as="geometry" /></mxCell><mxCell id="n621273f5a3" value="More training left?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1275" width="197" height="96" as="geometry" /></mxCell><mxCell id="n5168dc2de7" value="Save the trained AdaDDAE model" style="shape=cylinder3;whiteSpace=wrap;html=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1389" width="254" height="44" as="geometry" /></mxCell><mxCell id="nd0e092af2c" value="Score each test sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1451" width="195" height="44" as="geometry" /></mxCell><mxCell id="n058786273c" value="Build several score views:&#10;rebuild · hidden features · leftover error&#10;uncertainty · time-based" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1513" width="343" height="77" as="geometry" /></mxCell><mxCell id="n3919d210e8" value="Pick useful noise levels by signal quality" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1608" width="343" height="44" as="geometry" /></mxCell><mxCell id="nf9b414d9a9" value="How should scores be combined?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1670" width="278" height="96" as="geometry" /></mxCell><mxCell id="n6c9c88d9bd" value="Standard / tuned mix of score views" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1784" width="291" height="44" as="geometry" /></mxCell><mxCell id="nd91fc1758e" value="Best of several scores&#10;(for hard cases)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1846" width="195" height="60" as="geometry" /></mxCell><mxCell id="n0a8716c19e" value="Optional careful mix with a simple baseline&#10;(only when it helps)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1924" width="360" height="60" as="geometry" /></mxCell><mxCell id="n630b757c18" value="Is this result worse than the locked&#10;reference by more than a tiny amount?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2002" width="330" height="96" as="geometry" /></mxCell><mxCell id="n6214633a61" value="Yes — keep the safer locked result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2116" width="284" height="44" as="geometry" /></mxCell><mxCell id="nfc53b1e9f7" value="No — accept this AdaDDAE result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2178" width="261" height="44" as="geometry" /></mxCell><mxCell id="n06477e4045" value="Output: unusualness score for each sample" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2240" width="335" height="44" as="geometry" /></mxCell><mxCell id="ncde42e9e84" value="Output: quality scores for this dataset" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2302" width="321" height="44" as="geometry" /></mxCell><mxCell id="n87c2392a4a" value="Save metrics for this dataset / seed / setting" style="shape=cylinder3;whiteSpace=wrap;html=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2364" width="360" height="60" as="geometry" /></mxCell><mxCell id="n4a5cca508b" value="All datasets finished?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2442" width="219" height="96" as="geometry" /></mxCell><mxCell id="nf49c66bc7b" value="Combine results across datasets&#10;(only keep safe improvements)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2556" width="261" height="60" as="geometry" /></mxCell><mxCell id="n315c91f8e0" value="Run quality checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2634" width="165" height="44" as="geometry" /></mxCell><mxCell id="n447a9d8a02" value="Output: AdaDDAE final report&#10;(overall score about 50.12%)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2696" width="239" height="60" as="geometry" /></mxCell><mxCell id="nb60b523a1c" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2774" width="110" height="44" as="geometry" /></mxCell><mxCell id="e07976efff5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#666666;fontSize=11;align=center;" edge="1" parent="1" source="n3dab5a2900" target="n9ab3b26b5e"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e241a8173f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#666666;fontSize=11;align=center;" edge="1" parent="1" source="n9ab3b26b5e" target="n50a4f3c41f"><mxGeometry r