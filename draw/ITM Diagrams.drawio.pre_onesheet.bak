        <mxCell id="c1_d_c_1a34546376" value="Contrastive learning&#xa;enabled?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="890.0" y="1516.0" width="160" height="88" as="geometry" /></mxCell>
        <mxCell id="c1_pc1_f38f294edd" value="Build positive pairs:&#xa;two clean samples" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="764.0" y="1640.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c1_pc2_46673cd8da" value="Build negative pairs:&#xa;clean vs noisy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="764.0" y="1746.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c1_pc3_403706ff6d" value="Set margin m = 1 + t/T" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="764.0" y="1852.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c1_pc4_28e6810c1b" value="Compute contrastive loss&#xa;in latent space" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="764.0" y="1958.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c1_pc5_866cf4fd9f" value="Total loss =&#xa;reconstruction + contrastive" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="764.0" y="2064.0" width="200" height="70" as="geometry" /></mxCell>
