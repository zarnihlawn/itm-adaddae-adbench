        <mxCell id="c0_in1_707153552a" value="Input:&#xa;ADBench dataset&#xa;features X, labels y" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="230.0" y="238.0" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="c0_in2_a723a0370f" value="Input:&#xa;Fixed diffusion settings&#xa;(T, beta start/end, schedule type)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="230.0" y="338.0" width="200" height="64" as="geometry" /></mxCell>
        <mxCell id="c0_p0_16eee3644c" value="Standardize features&#xa;(zero mean, unit variance)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#000000;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="230.0" y="438.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c0_dset_44045457c2" value="Learning setting?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="250.0" y="544.0" width="160" height="88" as="geometry" /></mxCell>
        <mxCell id="c0_pu_d1e1e34e73" value="Unlabeled setup:&#xa;use all samples for&#xa;training and testing" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="124.0" y="668.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c0_ps_21f65be23a" value="Partly-labeled setup:&#xa;train on 50% normals only;&#xa;test = rest normals + anomalies" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="336.0" y="668.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c0_p1_d4037522fd" value="Initialize encoder–decoder&#xa;with time-step embedding" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="774.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c0_p2_9abcadccef" value="Build fixed noise schedule&#xa;β₁…β_T  (linear / cosine / …)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="880.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c0_p3_a8958f9b05" value="For each training epoch&#xa;and each data batch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="986.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c0_p4_c80373b9de" value="Sample random noise level t&#xa;from 1 … T" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="1216.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c0_p5_67df4a445b" value="Sample Gaussian noise ε" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="1322.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c0_p6_5c43745fb3" value="Make noisy sample:&#xa;x_t = √ᾱ_t · x₀ + √(1−ᾱ_t) · ε" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="1428.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c0_p7_0e6d102d8d" value="Predict clean data x̂₀&#xa;from (x_t , t)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="1534.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c0_p8_875b6dca3e" value="Compute reconstruction loss&#xa;‖x₀ − x̂₀‖²" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="1640.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c0_p9_ea51b5ce13" value="Update model parameters&#xa;by gradient descent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="1746.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c0_d_ep_572cae860f" value="More batches /&#xa;epochs remaining?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="250.0" y="1852.0" width="160" height="88" as="geometry" /></mxCell>
        <mxCell id="c0_d_ev_352c3ee20b" value="Evaluation point&#xa;reached?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="356.0" y="1092.0" width="160" height="88" as="geometry" /></mxCell>
        <mxCell id="c0_score_loop_a0af301122" value="Scoring: for every noise level&#xa;t = 1 … T−1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="1976.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c0_sc1_a9ef485e8b" value="Corrupt test sample at level t" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="2164.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c0_sc2_e11556c2d9" value="Reconstruct clean estimate x̂₀" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="2270.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c0_sc3_de1f6a8067" value="Add reconstruction error&#xa;to running anomaly score" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4A4A4A;fontColor=#000000;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="2376.0" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="c0_d_t_46af0be582" value="All noise levels&#xa;finished?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="250.0" y="2482.0" width="160" height="88" as="geometry" /></mxCell>
        <mxCell id="c0_out1_6badce4827" value="Output:&#xa;Cumulative anomaly score S(x)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#000000;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="124.0" y="2606.0" width="200" height="64" as="geometry" /></mxCell>
