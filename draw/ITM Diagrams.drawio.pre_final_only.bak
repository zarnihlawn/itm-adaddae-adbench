ry x="40" y="545" width="217" height="42" as="geometry" /></mxCell><mxCell id="n_a1c3a95505" value="Build a fixed noise plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="605" width="210" height="42" as="geometry" /></mxCell><mxCell id="n_f8ab3b5d06" value="For each training round and each data group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="665" width="269" height="58" as="geometry" /></mxCell><mxCell id="n_3d811c3286" value="Evaluation point reached?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="741" width="237" height="78" as="geometry" /></mxCell><mxCell id="n_1a27fa8404" value="Pick a random noise level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="837" width="217" height="42" as="geometry" /></mxCell><mxCell id="n_9e777f9352" value="Create random noise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="897" width="173" height="42" as="geometry" /></mxCell><mxCell id="n_2164cab0f3" value="Add noise to the sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="957" width="202" height="42" as="geometry" /></mxCell><mxCell id="n_5c08686921" value="Try to rebuild the clean sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1017" width="261" height="42" as="geometry" /></mxCell><mxCell id="n_8